# Copy to backend/.env.prod on the server:
#   cp deploy/hetzner/.env.example backend/.env.prod
#
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Database ───────────────────────────────────────────────────────
# Must match OLBOSTRADE_DB_PASSWORD in docker-compose.hetzner.yml
OLBOSTRADE_DB_PASSWORD=change-me-long-random-string

# DATABASE_URL is injected by docker-compose.hetzner.yml (pointing to the
# olbostrade-db container). Leave it blank here — docker-compose overrides it.
# No Redis is used by this deployment.
DATABASE_URL=

# ── App security ───────────────────────────────────────────────────
# Trade-desk mutate routes (manual trade, approve, close position, signal,
# execution mode) require header X-Api-Key to match this value once set.
# Enter the same value in the app's Risk → Operator API Key field.
# Leave blank only for local/dev — an empty value disables the check.
SECRET_KEY=

# ── Trading (paper only — do NOT change BROKER to live) ───────────
BROKER=ibkr
# Docker network hostname when ibkr-gateway runs on the same host (see README)
IBKR_HOST=ibkr-gateway
# gnzsnz/ib-gateway socat paper port inside the container (not 4002)
IBKR_PORT=4004
IBKR_CLIENT_ID=2
IBKR_TRADING_MODE=paper
STARTING_CAPITAL=25000.0

# ── Risk defaults ──────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=10

# ── Equity signal geometry ─────────────────────────────────────────
# stop = entry ∓ ATR×STOP_MULT, target = entry ± ATR×TARGET_MULT, so the
# defaults below put the target twice as far as the stop (2:1).
#
# Only affects NEWLY generated signals: each one persists the stop and
# target prices it was created with, so retuning cannot relabel history.
#
# Before changing these, read by_mfe_bucket_r against target_distance_r in
# /api/signal-research/outcomes. If favourable excursion rarely reaches the
# target's distance in R, the target is out of reach within the 20-day
# expiry and is turning winners into expiries. Changing the ratio does not
# create an edge — breakeven and the coin-flip hit rate are the same number
# for every ratio — it decides how much of a move you try to capture.
EQUITY_STOP_ATR_MULTIPLIER=2.0
EQUITY_TARGET_ATR_MULTIPLIER=4.0

# ── Proxy trust (REQUIRED on the Hetzner stack) ────────────────────
# Shared secret proving a request reached the backend through the frontend
# nginx — the only thing that overwrites X-Forwarded-For with the address it
# actually observed. Without it the backend ignores that header and every
# caller behind the proxy lands in ONE login rate-limit bucket: ten failed
# logins lock out everybody, including you.
#
# docker-compose.hetzner.yml REQUIRES this (both services read it), so the
# stack refuses to start until it is set. Generate one with:
#   openssl rand -hex 32
# Application authentication. REQUIRED — docker-compose.hetzner.yml refuses to
# start without it, because an absent line and AUTH_ENABLED=false look
# identical from outside and the second one silently leaves the app unguarded.
#
#   false  accounts are off; the app relies on nginx Basic Auth (DASH_USER /
#          DASH_PASS) and the X-Api-Key operator key, exactly as before.
#   true   real accounts, sessions, the access-request queue, and Free/Pro/
#          Elite tier limits. Requires SECRET_KEY to be set.
#
# Ship it as true while Basic Auth is STILL in front, verify you can sign in,
# and only then remove Basic Auth. Confirm which mode is live with:
#     curl -s https://<host>/api/auth/status
AUTH_ENABLED=false

TRUSTED_PROXY_SECRET=


CAPITAL_PRESERVATION_THRESHOLD=0.85

# ── Optional external services ─────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GEMINI_API_KEY=
SENDGRID_API_KEY=

# ── Dashboard access control (HTTP Basic Auth over the whole app) ──
# Set BOTH to require a username/password before anyone can reach the
# dashboard or API. Strongly recommended when exposing the app by public IP.
# Leave blank to serve open (local/dev only).
DASH_USER=
DASH_PASS=

# ── Login rate limiting behind Caddy ───────────────────────────────
# Caddy's Docker subnet. Required for the per-IP login rate limit (10 attempts
# / 5 min) to work on the DOMAIN path: Caddy is the peer nginx sees, so without
# this nginx keeps Caddy's address as the client and every caller on
# https://trading.<your-domain> shares ONE bucket — ten failed logins lock out
# everybody, including you. Direct IP access (http://<server-ip>:8080) is
# unaffected either way.
#
# Blank is the safe default, not the complete one: it trusts nobody rather than
# believing a header anyone could set. Set it deliberately once you deploy
# behind Caddy. Find the subnet with:
#   docker network inspect docker_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Never widen it to a range a real client could originate from.
#
# More than one? Separate with COMMAS, no spaces — up.sh sources this file with
# bash, which would read a space as the end of the value and try to run the
# rest as a command:
#   TRUSTED_PROXY_CIDR=172.18.0.0/16,172.19.0.0/16
TRUSTED_PROXY_CIDR=

# ── Database backups (deploy/hetzner/backup_db.sh) ─────────────────
# Local dumps always written to BACKUP_DIR (default /opt/olbostrade-backups),
# pruned after BACKUP_RETENTION_DAYS (default 14). For OFF-SITE copies set ONE:
#   BACKUP_RCLONE_REMOTE=myremote:olbostrade-backups   # rclone (S3/B2/GDrive…)
#   BACKUP_SCP_TARGET=user@host:/path/olbostrade-backups
BACKUP_DIR=
BACKUP_RETENTION_DAYS=
BACKUP_RCLONE_REMOTE=
BACKUP_SCP_TARGET=

# ── Execution test mode (PAPER validation) ─────────────────────────
# true = bypass the quality/frequency guards so the system actually places
# trades, to verify the pipeline end-to-end. Hard safety rails still apply
# (kill switch, paper/account guard, market hours, margin, sizing). NEVER leave
# on for a real run. Pair with MARKET_HOURS_ONLY=false to attempt off-hours.
EXECUTION_TEST_MODE=false

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=production
