# ──────────────────────────────────────────────
# Active broker (ibkr | alpaca)
# ──────────────────────────────────────────────
BROKER=ibkr

# ── IBKR ──────────────────────────────────────
# Requires a running IBKR Gateway/TWS process per account (see docker-compose's
# ibkr-gateway service) — not practical to run one per SaaS customer at scale.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper
IBKR_USERNAME=
IBKR_PASSWORD=
VNC_PASSWORD=localdev

# ── Alpaca ────────────────────────────────────
# Plain REST API, no per-account Gateway process — set BROKER=alpaca to use
# this instead of IBKR. Get keys from https://app.alpaca.markets (paper
# trading keys are free, no business verification required).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=options_user
POSTGRES_PASSWORD=options_pass
POSTGRES_DB=options_db
DATABASE_URL=postgresql+asyncpg://options_user:options_pass@postgres:5432/options_db

# ──────────────────────────────────────────────
# Trading Rules
# ──────────────────────────────────────────────
STARTING_CAPITAL=25000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_MONTHLY_LOSS_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=6

# ── Equity signal geometry ─────────────────────────────────────────
# stop = entry ∓ ATR×STOP_MULT, target = entry ± ATR×TARGET_MULT, so the
# defaults below put the target twice as far as the stop (2:1).
#
# Only affects NEWLY generated signals: each one persists the stop and
# target prices it was created with, so retuning cannot relabel history.
#
# Before changing these, read by_mfe_bucket_r against target_distance_r in
# /api/signal-research/outcomes. If favourable excursion rarely reaches the
# target's distance in R, the target is out of reach within the 20-day
# expiry and is turning winners into expiries. Changing the ratio does not
# create an edge — breakeven and the coin-flip hit rate are the same number
# for every ratio — it decides how much of a move you try to capture.
EQUITY_STOP_ATR_MULTIPLIER=2.0
EQUITY_TARGET_ATR_MULTIPLIER=4.0

# ── Proxy trust (REQUIRED on the Hetzner stack) ────────────────────
# Shared secret proving a request reached the backend through the frontend
# nginx — the only thing that overwrites X-Forwarded-For with the address it
# actually observed. Without it the backend ignores that header and every
# caller behind the proxy lands in ONE login rate-limit bucket: ten failed
# logins lock out everybody, including you.
#
# docker-compose.hetzner.yml REQUIRES this (both services read it), so the
# stack refuses to start until it is set. Generate one with:
#   openssl rand -hex 32
TRUSTED_PROXY_SECRET=


MAX_CONSECUTIVE_LOSSES=3
COOLING_OFF_HOURS=24
CAPITAL_PRESERVATION_THRESHOLD=0.85
MAX_EQUITY_POSITIONS=5
MAX_OPTIONS_POSITIONS=5

# Paper → live tenure gate. The charter requires a paper-trading track record
# before any live capital. With IBKR_TRADING_MODE=live, orders are blocked until
# BOTH floors are met: days since the first recorded trade, and finished
# (closed/expired) trades. Ignored entirely in paper mode. Set the days to 0 AND
# the trades to 0 to disable the gate — a deliberate, auditable config change.
LIVE_MIN_PAPER_TRADING_DAYS=90
LIVE_MIN_PAPER_CLOSED_TRADES=20

# Deployment capability. false makes this instance structurally incapable of
# placing an order — get_broker() returns a read-only wrapper whose
# place_order/place_equity_order raise, so no route, scanner or autopilot path
# can trade regardless of execution mode. Closing and cancelling stay allowed:
# they only reduce exposure.
#
# This is the SHARED tier of the hybrid tenancy model (signals + research for
# many accounts); execution runs in a separate per-tenant stack. Leave true for
# a normal single-operator install.
EXECUTION_ENABLED=true

# Only submit orders during US regular trading hours (09:30–16:00 ET, Mon–Fri,
# excluding holidays). The app still runs 24/7 and resumes trading automatically
# at the open. Set to false to allow order attempts at any time (not recommended).
MARKET_HOURS_ONLY=true

# ──────────────────────────────────────────────
# Equity signal settings
# ──────────────────────────────────────────────
EQUITY_WATCHLIST=AAPL,NVDA,MSFT,META,AMZN,GOOGL,AMD,TSLA,SPY,QQQ,JPM,V,MA
EQUITY_SIGNAL_INTERVAL_MINUTES=15
# Symbols scanned per background-scan tick. 0 = whole watchlist every cycle
# (recommended — more candidates evaluated, same confidence bar). Set to a
# smaller number (e.g. 5) to go back to the old rotating-window behavior.
EQUITY_SCAN_WINDOW_SIZE=0
EQUITY_MIN_CONFIDENCE=0.62
EQUITY_MIN_RISK_REWARD=1.80
EARNINGS_GATE_DAYS=3

# ──────────────────────────────────────────────
# AI Signal Scorer
# ──────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=0.65
SIGNAL_SCORE_PRESERVATION_MODE=0.80
MODEL_PATH=ml/model_registry/signal_scorer_v1.pkl
RETRAIN_SCHEDULE=monthly

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# When set, trade-desk mutate routes (approve, mode, manual-trade, scan submit)
# require header X-Api-Key. Enter the same value in Risk → Operator API Key
# (sessionStorage only — never commit this value into frontend source).
SECRET_KEY=

# Required to reset an engaged kill switch. Operator types it in the UI;
# never embed this string in the frontend bundle.
KILL_SWITCH_RESET_CODE=

# Step 8 portfolio gate on _execute_signal (concentration / max positions / heat).
# Set false to roll back without redeploying code. Greeks caps stay off unless
# EXECUTION_ENFORCE_PORTFOLIO_GREEKS=true (not recommended — miscalibrated).
EXECUTION_PORTFOLIO_GATE=true
EXECUTION_ENFORCE_PORTFOLIO_GREEKS=false

# ── Per-user login ────────────────────────────
# Off by default, and it must stay off until you have created an account —
# turning it on with an empty users table locks you out of your own instance.
#
#   docker compose exec backend python scripts/create_user.py --email you@example.com
#   # then set AUTH_ENABLED=true and restart
#
# While false, nothing changes: the instance keeps running on nginx Basic Auth
# plus the SECRET_KEY operator key above, exactly as before.
#
# While true, every route requires a session cookie EXCEPT this allowlist
# (app/api/auth_deps.py, PUBLIC_EXACT + PUBLIC_PREFIXES):
#   /api/auth/login, /api/auth/logout, /api/health, /health, /
#   /docs, /redoc, /openapi.json, /static/*, /assets/*
# Note /docs and /openapi.json are on that list: a full map of every route
# stays readable without a session. Harmless behind nginx Basic Auth; decide
# whether you still want it once Basic Auth comes down.
#
# This does not replace SECRET_KEY. The operator key gates the trade-desk
# mutate routes specifically; this gates the whole API. Keep both.
AUTH_ENABLED=false

# How long a login lasts. 12h means a session opened in the morning is gone by
# the next session — short enough that a forgotten browser is not a standing
# key to a brokerage connection.
AUTH_SESSION_HOURS=12

# Sends the session cookie only over HTTPS. Leave true in production. The only
# reason to set it false is plain-http local development, where a secure cookie
# is never returned and login appears to succeed but nothing stays logged in.
AUTH_COOKIE_SECURE=true

# ──────────────────────────────────────────────
# Broker credential encryption
# ──────────────────────────────────────────────
# Encrypts each user's OWN broker API keys at rest (Elite plan: System → My
# Brokers). Leave empty and that feature is simply unavailable — the routes
# answer 503 and nothing else on the install changes. It is never optional in
# the sense of "stores plaintext instead": without a key, credentials are not
# stored at all.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# KEEP IT. Rotating this makes every stored broker credential undecryptable
# and every connected user has to reconnect. That is exactly why it is its own
# variable rather than being derived from SECRET_KEY, which is rotated
# routinely and urgently after any suspected exposure — an incident response
# must not silently destroy data.
#
# The ALPACA_API_KEY / ALPACA_SECRET_KEY pair near the top of this file is a
# different thing: that is the OPERATOR's own account, used for execution
# today. This key protects credentials belonging to users.
BROKER_ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# Alerts
# ──────────────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL=
LOG_LEVEL=INFO
